#!/bin/sh /etc/rc.common
# LiteBox：mihomo 透明代理服务（procd 管理，崩溃自动拉起）

START=99
STOP=10
USE_PROCD=1

BIN=/usr/lib/litebox/mihomo
HOME_DIR=/etc/litebox

start_service() {
	[ -x "$BIN" ] && [ -f "$HOME_DIR/config.yaml" ] || return 1
	# 还没填订阅时不启动：否则开机后 DNS 被接管，境外网站却没有节点可用
	if grep -q 'sub.invalid/litebox-placeholder' "$HOME_DIR/config.yaml"; then
		logger -t litebox "还没有设置订阅，不启动。设置：litebox sub '订阅地址'，或在路由器后台「服务 → LiteBox」里填"
		return 1
	fi
	MEM_SOFT_MB=100
	[ -f "$HOME_DIR/litebox.conf" ] && . "$HOME_DIR/litebox.conf"

	procd_open_instance
	procd_set_param command "$BIN" -d "$HOME_DIR" -f "$HOME_DIR/config.yaml"
	# Go 运行时软上限：接近这个值时更积极地回收内存
	procd_set_param env GOMEMLIMIT="${MEM_SOFT_MB}MiB" GOGC=50
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	/usr/bin/litebox dns-on
	/usr/bin/litebox panel-sync
	# 访客网络等其他能上网的区域也要放行到 litebox，否则会被 TUN 路由带进来后挡掉、整个断网
	/usr/bin/litebox zones-sync
	# 防火墙加速层要等内核开始监听，放后台做，不拖慢启动
	[ -x /usr/lib/litebox/firewall.sh ] && (/usr/lib/litebox/firewall.sh start >/dev/null 2>&1 &)
}

stop_service() {
	[ -x /usr/lib/litebox/firewall.sh ] && /usr/lib/litebox/firewall.sh stop
	/usr/bin/litebox dns-off
	# 关机、重启前把内存里的流量记录存回闪存
	[ -f /tmp/litebox-traffic.txt ] && cp /tmp/litebox-traffic.txt "$HOME_DIR/traffic.txt"
	return 0
}
